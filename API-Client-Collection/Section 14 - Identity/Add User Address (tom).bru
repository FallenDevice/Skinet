meta {
  name: Add User Address (tom)
  type: http
  seq: 13
}

post {
  url: {{url}}/api/account/address
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "line1": "100 Park Lane",
    "city": "London",
    "state": "London",
    "postalCode": "SW1 1BD",
    "country": "GB"
  }
}

settings {
  encodeUrl: true
}
