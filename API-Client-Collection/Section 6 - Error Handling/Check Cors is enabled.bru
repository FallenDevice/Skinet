meta {
  name: Check Cors is enabled
  type: http
  seq: 6
}

get {
  url: {{url}}/api/products
  body: none
  auth: inherit
}

headers {
  Origin: https://localhost:4200
}

script:post-response {
  test("CORS header is present", function () {
      expect(res.getHeaders()).to.have.property("access-control-allow-origin".toLowerCase());
      expect(res.getHeader("access-control-allow-origin")).to.eql("https://localhost:4200");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
